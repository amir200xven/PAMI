{
  "name": "hamkaran/pami",
  "type": "library",
  "description": "Asterisk Manager Interface (AMI) client for PHP, event driven, object oriented",
  "keywords": [
    "action",
    "ami",
    "asterisk",
    "client",
    "event",
    "manager",
    "monitor",
    "telephony",
    "voip"
  ],
  "homepage": "https://github.com/amir200xven/PAMI",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Marcelo Gornstein",
      "email": "marcelog@gmail.com",
      "homepage": "https://marcelog.github.io/",
      "role": "Original author"
    },
    {
      "name": "Hamkaran Cloud Telephony",
      "homepage": "https://hamkaran.cloud",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/amir200xven/PAMI/issues",
    "source": "https://github.com/amir200xven/PAMI"
  },
  "autoload": {
    "psr-4": {
      "PAMI\\": "src/PAMI/"
    }
  },
  "require": {
    "php": "^8.4",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "monolog/monolog": "^3.0",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "scripts": {
    "test": "phpunit -c test/resources/phpunit.xml",
    "syntax": "@php scripts/check-syntax.php",
    "lint": "phpcs --standard=PSR12 src"
  },
  "config": {
    "sort-packages": true
  }
}
